generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model PaymentLink {
  id                String    @id @default(cuid())
  title             String
  description       String?
  amount            String
  recipientAddress  String
  stealthAddress    String?
  stealthPrivateKey String?
  status            String    @default("ACTIVE")
  expiresAt         DateTime?
  txHash            String?
  forwardTxHash     String?
  paidBy            String?
  paidAt            DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
}

model EscrowLink {
  id                  String          @id @default(cuid())
  title               String
  description         String?
  amount              String
  sellerAddress       String
  sellerContact       String?
  buyerAddress        String?
  stealthAddress      String
  stealthPrivateKey   String?
  circleWalletId      String?
  status              String          @default("ACTIVE")
  txHash              String?
  releaseTxHash       String?
  feeTxHash           String?
  paidAt              DateTime?
  deliveryDays        Int?
  deliveryDeadline    DateTime?
  aiVerdict         String?
  aiConfidence      Int?
  aiReasoning       String?
  aiVerdictAt       DateTime?
  releaseDeadline     DateTime?
  confirmedAt         DateTime?
  disputedAt          DateTime?
  disputeReason       String?
  disputeDeadline     DateTime?
  sellerRespondedAt   DateTime?
  buyerLastMessageAt  DateTime?
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt
  messages            EscrowMessage[]
}

model EscrowMessage {
  id            String     @id @default(cuid())
  escrowId      String
  escrow        EscrowLink @relation(fields: [escrowId], references: [id])
  sender        String
  senderAddress String?
  message       String
  createdAt     DateTime   @default(now())
}

model X402Payment {
  id        String   @id @default(cuid())
  txHash    String   @unique
  payer     String
  payTo     String
  amount    String
  network   String
  resource  String
  nonce     String
  settledAt DateTime @default(now())
  createdAt DateTime @default(now())
}

model UserProfile {
  id          String   @id @default(cuid())
  address     String   @unique
  username    String   @unique
  displayName String?
  bio         String?
  email             String?
  avatar      String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Contact {
  id             String   @id @default(cuid())
  ownerAddress   String
  contactAddress String
  nickname       String?
  createdAt      DateTime @default(now())

  @@unique([ownerAddress, contactAddress])
}

model MarketplaceListing {
  id              String   @id @default(cuid())
  name            String
  description     String
  price           String
  endpoint        String
  category        String
  creatorAddress  String
  creatorUsername String?
  status          String   @default("PENDING")
  featured        Boolean  @default(false)
  tryItUrl        String?
  docsUrl         String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([status])
  @@index([category])
  @@index([creatorAddress])
}

model WalletReputation {
  id               String   @id @default(cuid())
  address          String   @unique
  completedEscrows Int      @default(0)
  disputedEscrows  Int      @default(0)
  refundedEscrows  Int      @default(0)
  totalVolume      String   @default("0")
  trustScore       Int      @default(100)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([address])
}

model SplitLink {
  id                String    @id @default(cuid())
  title             String
  description       String?
  amount            String                          // total amount payer sends
  creatorAddress    String
  circleWalletId    String?                         // SCA wallet that receives funds
  splitAddress      String    @default("pending")   // wallet address funds land in
  recipients        Json                            // [{ address, percentage, label? }]
  status            String    @default("ACTIVE")    // ACTIVE | HOLDING | DISTRIBUTING | COMPLETED | FAILED
  txHash            String?                         // payer's funding tx
  paidBy            String?
  paidAt            DateTime?
  payouts           Json?                           // [{ address, amount, txHash, status }]
  distributedAt     DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([creatorAddress])
}
model Webhook {
  id           String            @id @default(cuid())
  ownerAddress String
  url          String
  secret       String
  events       String[]                          // e.g. ["payment.completed","escrow.released"]
  active       Boolean           @default(true)
  failureCount Int               @default(0)
  lastFiredAt  DateTime?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  deliveries   WebhookDelivery[]

  @@index([ownerAddress])
}

model WebhookDelivery {
  id           String   @id @default(cuid())
  webhookId    String
  webhook      Webhook  @relation(fields: [webhookId], references: [id], onDelete: Cascade)
  event        String
  payload      Json
  statusCode   Int?
  success      Boolean  @default(false)
  errorMessage String?
  attempts     Int      @default(1)
  createdAt    DateTime @default(now())

  @@index([webhookId])
}
