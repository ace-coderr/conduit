{
    "name": "@ace_won/x402",
    "version": "1.0.0",
    "description": "Drop-in x402 payment middleware for Next.js — powered by Conduit on Arc Network. Wrap any API route with one line to require USDC micropayments.",
    "main": "dist/index.js",
    "module": "dist/index.mjs",
    "types": "dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.mjs",
            "require": "./dist/index.js"
        }
    },
    "files": [
        "dist",
        "README.md"
    ],
    "scripts": {
        "build": "tsup src/index.ts --format cjs,esm --dts --clean",
        "dev": "tsup src/index.ts --format cjs,esm --dts --watch",
        "prepublishOnly": "npm run build"
    },
    "keywords": [
        "x402",
        "payment",
        "middleware",
        "nextjs",
        "usdc",
        "arc",
        "arc-network",
        "circle",
        "micropayment",
        "web3",
        "eip-3009",
        "conduit"
    ],
    "author": "ace_won",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/ace-coderr/conduit.git"
    },
    "homepage": "https://conduit-pay.vercel.app/developers",
    "bugs": {
        "url": "https://github.com/ace-coderr/conduit/issues"
    },
    "peerDependencies": {
        "next": ">=14.0.0",
        "viem": ">=2.0.0"
    },
    "peerDependenciesMeta": {
        "viem": {
            "optional": true
        }
    },
    "devDependencies": {
        "@types/node": "^20",
        "tsup": "^8.0.0",
        "typescript": "^5"
    }
}
